<UserControl x:Class="SiteGrabberV3.Views.CrawlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SiteGrabberV3.Controls"
             Background="Transparent">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- URL bar -->
            <RowDefinition Height="Auto"/>   <!-- stat cards -->
            <RowDefinition Height="*"/>      <!-- map + console -->
        </Grid.RowDefinitions>

        <!-- ── URL / control bar ──────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- method -->
                    <ColumnDefinition Width="*"/>     <!-- url -->
                    <ColumnDefinition Width="Auto"/>  <!-- scope -->
                    <ColumnDefinition Width="Auto"/>  <!-- depth -->
                    <ColumnDefinition Width="Auto"/>  <!-- analyze -->
                    <ColumnDefinition Width="Auto"/>  <!-- stop -->
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="CmbMethod"
                          Style="{StaticResource DarkComboBox}"
                          Width="84" Margin="0,0,10,0">
                    <ComboBoxItem Content="GET" IsSelected="True"/>
                    <ComboBoxItem Content="POST"/>
                    <ComboBoxItem Content="HEAD"/>
                </ComboBox>

                <TextBox Grid.Column="1" x:Name="TxtUrl"
                         Style="{StaticResource DarkTextBox}"
                         Text="https://example.com"
                         Height="36" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"/>

                <ComboBox Grid.Column="2" x:Name="CmbScope"
                          Style="{StaticResource DarkComboBox}"
                          Width="130" Margin="0,0,10,0">
                    <ComboBoxItem Content="Full Crawl" IsSelected="True"/>
                    <ComboBoxItem Content="Pages Only"/>
                    <ComboBoxItem Content="Assets Only"/>
                    <ComboBoxItem Content="API Endpoints"/>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Depth" Foreground="{StaticResource BrMuted}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbDepth" Style="{StaticResource DarkComboBox}" Width="68">
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3" IsSelected="True"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="∞"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="4" x:Name="BtnAnalyze"
                        Style="{StaticResource BtnAccent}"
                        Content="⚡  Analyze"
                        Height="36" Width="116" FontSize="13" Margin="0,0,8,0"
                        Click="BtnAnalyze_Click"/>

                <Button Grid.Column="5" x:Name="BtnStop"
                        Style="{StaticResource BtnGhost}"
                        Content="■  Stop"
                        Height="36" Width="84" IsEnabled="False"
                        Click="BtnStop_Click"/>
            </Grid>
        </Border>

        <!-- ── Stat cards: four equal tiles, 12px gutters ─────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="URLs CRAWLED" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="LblUrls" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrAccent}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="LblUrlsSub" Text="pages + assets"
                               FontSize="11" Foreground="{StaticResource BrMuted}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="FILES SAVED" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="LblFiles" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrInfo}" Margin="0,4,0,0"/>
                    <TextBlock Text="mirrored to disk"
                               FontSize="11" Foreground="{StaticResource BrMuted}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="FINDINGS" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="LblFindings" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="secrets + configs"
                               FontSize="11" Foreground="{StaticResource BrMuted}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="SUBDOMAINS" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="LblSubdomains" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrViolet}" Margin="0,4,0,0"/>
                    <TextBlock Text="discovered"
                               FontSize="11" Foreground="{StaticResource BrMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Main split: crawl map | console + recent files ─────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Crawl map -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="CRAWL MAP" Style="{StaticResource CardTitle}"/>
                        <Border Background="#1A00D4AA" CornerRadius="9" Padding="8,1" Margin="10,0,0,0">
                            <TextBlock x:Name="LblMapNodes" Text="0 nodes"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrAccent}"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Padding="0" ClipToBounds="True">
                        <ctrl:CrawlMapControl x:Name="CrawlMap" Background="Transparent"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SlimSplitter}"
                          HorizontalAlignment="Stretch"/>

            <!-- Right: console + file list -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="190" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Console -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="CONSOLE" Style="{StaticResource CardTitle}"/>
                            <Button Content="Clear" Style="{StaticResource BtnGhost}"
                                    FontSize="10" Padding="8,1" HorizontalAlignment="Right"
                                    Click="BtnClearLog_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Inset}" Padding="10,8">
                            <ScrollViewer x:Name="ConsoleScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TxtConsole"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource BrText}"
                                           TextWrapping="Wrap"
                                           LineStackingStrategy="MaxHeight"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource SlimSplitterH}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Recent files -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,14,6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RECENT FILES" Style="{StaticResource CardTitle}"
                                   Margin="10,0,0,8"/>
                        <DataGrid Grid.Row="1" x:Name="GridFiles"
                                  Style="{StaticResource DarkGrid}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path"   Binding="{Binding Path}"   Width="*"/>
                                <DataGridTextColumn Header="Type"   Binding="{Binding Type}"   Width="56"/>
                                <DataGridTextColumn Header="Size"   Binding="{Binding SizeKB}" Width="64"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="52"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
