<UserControl x:Class="SiteGrabberV3.Views.HttpHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title + filter -->
            <RowDefinition Height="*"/>      <!-- list + inspector -->
        </Grid.RowDefinitions>

        <!-- ── Page header ───────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="HTTP History" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Every request the crawler made" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="TxtFilter" Style="{StaticResource DarkTextBox}"
                     Width="240" Height="36" FontSize="12" VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Text="Filter by URL…"
                     GotFocus="TxtFilter_GotFocus"
                     TextChanged="TxtFilter_TextChanged"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- HTTP entry list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6,6,6,8">
                <DataGrid x:Name="GridHttp"
                          Style="{StaticResource DarkGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionChanged="GridHttp_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"   Binding="{Binding TimeStr}"  Width="72"/>
                        <DataGridTemplateColumn Header="Method" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="9,2" HorizontalAlignment="Left"
                                            Background="{Binding Method,
                                              Converter={StaticResource MethodToColor}}">
                                        <TextBlock Text="{Binding Method}" FontSize="10"
                                                   FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="URL"    Binding="{Binding ShortUrl}"  Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"    Width="58"/>
                        <DataGridTextColumn Header="Size"   Binding="{Binding SizeStr}"   Width="58"/>
                        <DataGridTextColumn Header="Risk"   Binding="{Binding Risk}"      Width="64"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SlimSplitter}"
                          HorizontalAlignment="Stretch"/>

            <!-- Request / Response inspector -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab switcher -->
                    <Border Grid.Row="0" Margin="0,0,0,12" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabRequest" Content="Request"
                                         Style="{StaticResource TabBtn}" IsChecked="True"
                                         Checked="Tab_Checked" Tag="Request"/>
                            <RadioButton x:Name="TabResponse" Content="Response"
                                         Style="{StaticResource TabBtn}" Margin="4,0,0,0"
                                         Checked="Tab_Checked" Tag="Response"/>
                        </StackPanel>
                    </Border>

                    <!-- Both panes share one cell; the active one slides in -->
                    <Grid Grid.Row="1">
                        <Border x:Name="PaneRequest" Style="{StaticResource Inset}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtRequest"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap"
                                           Text="Select a request to inspect…"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="PaneResponse" Style="{StaticResource Inset}" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtResponse"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap"
                                           Text="Response body appears here…"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
