<UserControl x:Class="SiteGrabberV3.Views.SubdomainsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- table + options -->
        </Grid.RowDefinitions>

        <!-- ── Page header ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Subdomains" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Enumerate hosts under a root domain" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <!-- Green, blinking = scan results counter -->
            <ContentControl x:Name="BadgeCount" Style="{StaticResource StatusBadge}"
                            Content="0" Tag="ok" Margin="14,0,0,0"
                            ToolTip="Subdomains discovered"/>
        </StackPanel>

        <!-- ── Toolbar ───────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="TxtRoot" Style="{StaticResource DarkTextBox}"
                         Height="36" Margin="0,0,10,0" FontSize="13"
                         VerticalContentAlignment="Center"
                         Text="example.com"/>
                <Button Grid.Column="1" x:Name="BtnEnumerate" Content="🌐  Enumerate"
                        Style="{StaticResource BtnAccent}"
                        Height="36" Padding="20,0" FontSize="13" Margin="0,0,8,0"
                        Click="BtnEnumerate_Click"/>
                <Button Grid.Column="2" x:Name="BtnStopScan" Content="■  Stop"
                        Style="{StaticResource BtnGhost}"
                        Height="36" Padding="16,0" Margin="0,0,8,0" IsEnabled="False"
                        Click="BtnStop_Click"/>
                <Button Grid.Column="3" Content="⬇  Export" Style="{StaticResource BtnGhost}"
                        Height="36" Padding="16,0"
                        Click="BtnExport_Click"/>
            </Grid>
        </Border>

        <!-- ── Table + options ───────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Subdomain table -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6,6,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" x:Name="GridSubs"
                              Style="{StaticResource DarkGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subdomain" Binding="{Binding Subdomain}" Width="*"/>
                            <DataGridTextColumn Header="IP"        Binding="{Binding IP}"        Width="120"/>
                            <DataGridTextColumn Header="A Record"  Binding="{Binding ARecord}"   Width="120"/>
                            <DataGridTextColumn Header="CNAME"     Binding="{Binding CName}"     Width="150"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}"  Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="9,2" HorizontalAlignment="Left"
                                                Background="{Binding Status,
                                                  Converter={StaticResource StatusToColor}}">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Padding="10,10" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="LblProgress" Text="Ready"
                                   Style="{StaticResource TextMuted}" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SlimSplitter}"
                          HorizontalAlignment="Stretch"/>

            <!-- Scan methods panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="SCAN METHODS" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="True"
                                      Content="DNS Bruteforce" Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="True"
                                      Content="Certificate Transparency" Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource DarkCheck}" IsChecked="True"
                                      Content="Passive DNS (crt.sh)" Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource DarkCheck}"
                                      Content="AXFR Zone Transfer" Margin="0,0,0,10"/>
                            <CheckBox Style="{StaticResource DarkCheck}"
                                      Content="Reverse DNS Sweep" Margin="0,0,0,22"/>

                            <TextBlock Text="WORDLIST" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbWordlist" Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="Built-in (2k words)" IsSelected="True"/>
                                <ComboBoxItem Content="SecLists small (10k)"/>
                                <ComboBoxItem Content="SecLists large (50k)"/>
                                <ComboBoxItem Content="Custom…"/>
                            </ComboBox>

                            <TextBlock Text="THREADS" Style="{StaticResource CardTitle}" Margin="0,18,0,8"/>
                            <ComboBox x:Name="CmbThreads" Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100" IsSelected="True"/>
                                <ComboBoxItem Content="200"/>
                                <ComboBoxItem Content="500"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Scan status pinned to the bottom of the card -->
                    <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="0,16,0,0" Padding="12,14">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="LblScanStatus" Text="Idle"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrAccent}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="scan status" FontSize="10"
                                       Foreground="{StaticResource BrMuted}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
