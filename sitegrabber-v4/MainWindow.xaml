<Window x:Class="SiteGrabberV3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SiteGrabberV3.Views"
        Title="SiteGrabber v3.0"
        Icon="Assets/logo.ico"
        Width="1320" Height="820"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>   <!-- sidebar nav -->
            <ColumnDefinition Width="*"/>     <!-- content -->
            <ColumnDefinition Width="210"/>   <!-- file explorer + quick actions -->
        </Grid.ColumnDefinitions>

        <!-- ── Backdrop: soft colour glows so the glass panels have something to sit on.
                  Static gradients only (no blur effects) so it costs nothing per frame. -->
        <Grid Grid.ColumnSpan="3" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A0E1A" Offset="0"/>
                    <GradientStop Color="#0B1322" Offset="0.55"/>
                    <GradientStop Color="#08101C" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-120,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2800D4AA" Offset="0"/>
                        <GradientStop Color="#0000D4AA" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="120,0,0,-380">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#242B6CF6" Offset="0"/>
                        <GradientStop Color="#002B6CF6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- ── Left nav sidebar ──────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="#B0090E1B"
                BorderBrush="#14FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Border Grid.Row="0" Padding="20,22,20,18"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/logo.png" Width="28" Height="28"/>
                            <TextBlock Text="SiteGrabber" Margin="8,0,0,0"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#1A00D4AA" CornerRadius="9"
                                Padding="8,2" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="v3.0" FontSize="9"
                                       Foreground="{StaticResource BrAccent}"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <Grid Grid.Row="1" x:Name="NavHost" Margin="0,14,0,0">
                    <!-- One shared accent bar that glides to the selected item -->
                    <Border x:Name="NavIndicator" Width="3" Height="22" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource BrAccent}"
                            Panel.ZIndex="2" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavIndicatorShift" Y="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="RECON" FontSize="10" FontWeight="Bold"
                                   Foreground="#64748B" Margin="26,0,0,6"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavCrawler" Content="🕷  Crawler"
                                     IsChecked="True" Checked="Nav_Checked" Tag="Crawler"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavResults" Content="🔍  Results"
                                     Checked="Nav_Checked" Tag="Results"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavHttp" Content="📡  HTTP History"
                                     Checked="Nav_Checked" Tag="Http"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavRepeater" Content="🔁  Request Repeater"
                                     Checked="Nav_Checked" Tag="Repeater"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavSubdomains" Content="🌐  Subdomains"
                                     Checked="Nav_Checked" Tag="Subdomains"/>

                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold"
                                   Foreground="#64748B" Margin="26,18,0,6"/>
                        <RadioButton Style="{StaticResource NavBtn}"
                                     x:Name="NavSettings" Content="⚙  Settings"
                                     Checked="Nav_Checked" Tag="Settings"/>
                    </StackPanel>
                </Grid>

                <!-- User strip -->
                <Border Grid.Row="2" Padding="20,12"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{StaticResource BrBorder}">
                                <TextBlock Text="P" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="p0lz0ner" Margin="7,0,0,0"
                                       FontSize="12" Foreground="{StaticResource BrText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="7" Height="7"
                                     x:Name="StatusDot"
                                     Fill="{StaticResource BrLow}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="Ready"
                                       FontSize="10" Foreground="{StaticResource BrMuted}"
                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── View content area ─────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <views:CrawlerView     x:Name="ViewCrawler"    Visibility="Visible"/>
            <views:ResultsView     x:Name="ViewResults"    Visibility="Collapsed"/>
            <views:HttpHistoryView x:Name="ViewHttp"       Visibility="Collapsed"/>
            <views:RepeaterView    x:Name="ViewRepeater"   Visibility="Collapsed"/>
            <views:SubdomainsView  x:Name="ViewSubdomains" Visibility="Collapsed"/>
            <views:SettingsView    x:Name="ViewSettings"   Visibility="Collapsed"/>
        </Grid>

        <!-- ── Right sidebar: File Explorer + Quick Actions ─────────────── -->
        <Border Grid.Column="2"
                Background="#B0090E1B"
                BorderBrush="#14FFFFFF"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- File Explorer -->
                <Border Grid.Row="0" Padding="16,18,16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"
                                       Foreground="{StaticResource BrAccent}"/>
                            <TextBlock Text="File Explorer" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="↻" FontSize="14" Margin="8,0,0,0"
                                       Foreground="{StaticResource BrMuted}"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="RefreshTree_Click"/>
                        </StackPanel>
                        <TreeView Grid.Row="1" x:Name="FileTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource BrText}"
                                  FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Row="1" Padding="16,14,16,18"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0"
                                       Foreground="{StaticResource BrAccent}"/>
                            <TextBlock Text="Quick Actions" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrText}"/>
                        </StackPanel>
                        <Button Style="{StaticResource BtnGhost}" Content="💾  Save Report"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                Click="BtnSaveReport_Click"/>
                        <Button Style="{StaticResource BtnGhost}" Content="⬇  Export CSV"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                Click="BtnExportCsv_Click"/>
                        <Button Style="{StaticResource BtnGhost}" Content="📂  Open Folder"
                                HorizontalAlignment="Stretch"
                                Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
