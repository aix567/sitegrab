<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Color tokens ──────────────────────────────────────────────────── -->
    <Color x:Key="ColBg">#0A0E1A</Color>
    <Color x:Key="ColSurface">#111827</Color>
    <Color x:Key="ColCard">#1F2937</Color>
    <Color x:Key="ColSidebar">#0D1424</Color>
    <Color x:Key="ColBorder">#2D3748</Color>
    <Color x:Key="ColAccent">#00D4AA</Color>
    <Color x:Key="ColAccentDim">#00A87F</Color>
    <Color x:Key="ColText">#F1F5F9</Color>
    <Color x:Key="ColMuted">#94A3B8</Color>
    <Color x:Key="ColCritical">#EF4444</Color>
    <Color x:Key="ColHigh">#F97316</Color>
    <Color x:Key="ColMedium">#EAB308</Color>
    <Color x:Key="ColLow">#22C55E</Color>
    <Color x:Key="ColInfo">#3B82F6</Color>
    <Color x:Key="ColViolet">#A78BFA</Color>
    <Color x:Key="ColGet">#22C55E</Color>
    <Color x:Key="ColPost">#F97316</Color>

    <SolidColorBrush x:Key="BrBg"       Color="{StaticResource ColBg}"/>
    <SolidColorBrush x:Key="BrSurface"  Color="{StaticResource ColSurface}"/>
    <SolidColorBrush x:Key="BrCard"     Color="{StaticResource ColCard}"/>
    <SolidColorBrush x:Key="BrSidebar"  Color="{StaticResource ColSidebar}"/>
    <SolidColorBrush x:Key="BrBorder"   Color="{StaticResource ColBorder}"/>
    <SolidColorBrush x:Key="BrAccent"   Color="{StaticResource ColAccent}"/>
    <SolidColorBrush x:Key="BrText"     Color="{StaticResource ColText}"/>
    <SolidColorBrush x:Key="BrMuted"    Color="{StaticResource ColMuted}"/>
    <SolidColorBrush x:Key="BrCritical" Color="{StaticResource ColCritical}"/>
    <SolidColorBrush x:Key="BrHigh"     Color="{StaticResource ColHigh}"/>
    <SolidColorBrush x:Key="BrMedium"   Color="{StaticResource ColMedium}"/>
    <SolidColorBrush x:Key="BrLow"      Color="{StaticResource ColLow}"/>
    <SolidColorBrush x:Key="BrInfo"     Color="{StaticResource ColInfo}"/>
    <SolidColorBrush x:Key="BrViolet"   Color="{StaticResource ColViolet}"/>
    <SolidColorBrush x:Key="BrTransparent" Color="Transparent"/>

    <!-- ── Glass tokens (all #AARRGGBB) ──────────────────────────────────── -->
    <LinearGradientBrush x:Key="BrGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2AFFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrGlassBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#10FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrGlassHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BrGlassInset" Color="#66050810"/>

    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{StaticResource BrMuted}"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>
    <Style x:Key="TextAccent" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Margin"     Value="0,2,0,0"/>
    </Style>
    <Style x:Key="TextStat" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"   Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ── ScrollBar slim dark ───────────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="6"/>
        <Setter Property="MinWidth"    Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#374151" CornerRadius="3"
                                                    Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ── TextBox ────────────────────────────────────────────────────────── -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background"   Value="{StaticResource BrGlassInset}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush"  Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="10,8"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="CaretBrush"   Value="{StaticResource BrAccent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <!-- stretch (don't centre) so multi-line editors start at the top;
                             single-line boxes get VerticalContentAlignment=Center below -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox ──────────────────────────────────────────────────────── -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background"   Value="{StaticResource BrGlassInset}"/>
        <Setter Property="Foreground"   Value="{StaticResource BrText}"/>
        <Setter Property="BorderBrush"  Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"      Value="10,6"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Height"       Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="▾"
                                       Foreground="{StaticResource BrMuted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border Background="#F2111827" BorderBrush="#33FFFFFF"
                                        BorderThickness="1" CornerRadius="8" Margin="0,2,0,0" Padding="2">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding"    Value="10,6"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#2600D4AA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ────────────────────────────────────────────────────────── -->
    <Style x:Key="BtnAccent" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrAccent}"/>
        <Setter Property="Foreground"   Value="#0A0E1A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily"   Value="Segoe UI Semibold"/>
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Padding"      Value="24,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#00FFCC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#00A87F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"  Value="#33FFFFFF"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Padding"      Value="14,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1400D4AA"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2600D4AA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox ──────────────────────────────────────────────────────── -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrMuted}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                BorderBrush="#40FFFFFF" BorderThickness="1"
                                Background="#14000000" Margin="0,0,8,0">
                            <TextBlock x:Name="chk" Text="✓" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="#2200D4AA"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BrAccent}"/>
                            <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slider (slim, accent-filled) ──────────────────────────────────── -->
    <Style x:Key="DarkSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{StaticResource BrAccent}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#F1F5F9" Stroke="{StaticResource BrAccent}"
                                                     StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── DataGrid ──────────────────────────────────────────────────────── -->
    <Style x:Key="DarkGrid" TargetType="DataGrid">
        <Setter Property="Background"           Value="Transparent"/>
        <Setter Property="Foreground"           Value="{StaticResource BrText}"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#0FFFFFFF"/>
        <Setter Property="RowBackground"        Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#06FFFFFF"/>
        <Setter Property="HeadersVisibility"    Value="Column"/>
        <Setter Property="AutoGenerateColumns"  Value="False"/>
        <Setter Property="SelectionMode"        Value="Single"/>
        <Setter Property="CanUserResizeRows"    Value="False"/>
        <Setter Property="CanUserAddRows"       Value="False"/>
        <Setter Property="FontFamily"           Value="Segoe UI"/>
        <Setter Property="FontSize"             Value="12"/>
        <Setter Property="RowHeight"            Value="36"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"    Value="#0DFFFFFF"/>
        <Setter Property="Foreground"    Value="{StaticResource BrMuted}"/>
        <Setter Property="FontFamily"    Value="Segoe UI Semibold"/>
        <Setter Property="FontSize"      Value="11"/>
        <Setter Property="Padding"       Value="12,8"/>
        <Setter Property="BorderBrush"   Value="#1AFFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SeparatorBrush" Value="Transparent"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0FFFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A00D4AA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"       Value="{StaticResource BrText}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="12,0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Tab-style button: underline grows from the centre when selected ──── -->
    <Style x:Key="TabBtn" TargetType="RadioButton">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource BrMuted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Padding"      Value="14,8"/>
        <Setter Property="Focusable"    Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="root" Background="Transparent">
                        <Border x:Name="hover" CornerRadius="8" Background="#0DFFFFFF" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="line" Height="2" CornerRadius="1"
                                Margin="10,0,10,0" VerticalAlignment="Bottom"
                                Background="{StaticResource BrAccent}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="lineScale" ScaleX="0" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="lineScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="lineScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar nav button ─────────────────────────────────────────────────
         Hover/selected highlights are translucent overlays that fade in/out.
         (The sliding accent bar is a single shared element in MainWindow.)     -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource BrMuted}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Margin"           Value="0,1"/>
        <Setter Property="Focusable"        Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="hover" Margin="10,0,10,0" CornerRadius="8"
                                Background="#0DFFFFFF" Opacity="0"/>
                        <Border x:Name="sel" Margin="10,0,10,0" CornerRadius="8"
                                Background="#1A00D4AA" Opacity="0"/>
                        <ContentPresenter Margin="26,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Glass card (used for every panel) ──────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource BrGlass}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrGlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="12"/>
        <Setter Property="Padding"         Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrGlassHover}"/>
                <Setter Property="BorderBrush" Value="#3300D4AA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark inset well for code / proof / console text, sits inside a glass card -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource BrGlassInset}"/>
        <Setter Property="BorderBrush"     Value="#14FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="12"/>
    </Style>

    <!-- Section title inside a card -->
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Slim splitter: invisible bar with a thin grip, replaces the fat grey bars -->
    <Style x:Key="SlimSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="grip" Background="#22FFFFFF" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="2" Height="36"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal variant (for splitters that sit between stacked cards) -->
    <Style x:Key="SlimSplitterH" TargetType="GridSplitter" BasedOn="{StaticResource SlimSplitter}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="grip" Background="#22FFFFFF" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="36" Height="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource BrAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Round status badge ──────────────────────────────────────────────────
         Real Ellipse => always a perfect circle, whatever the number inside.
         Tag="crit"  : red, steady                (something critical was found)
         Tag="ok"    : green, blinking + halo     (nothing critical)
         (no Tag)    : accent teal, steady                                      -->
    <Style x:Key="StatusBadge" TargetType="ContentControl">
        <Setter Property="Width"  Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#0A0E1A"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <!-- halo: expands and fades (visible only while green) -->
                        <Ellipse x:Name="halo" Fill="#22C55E" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="haloScale" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="body" Fill="{StaticResource BrAccent}"/>
                        <Ellipse Stroke="#55FFFFFF" StrokeThickness="1"/>
                        <Viewbox Stretch="Uniform" MaxWidth="16" MaxHeight="14"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="crit">
                            <Setter TargetName="body" Property="Fill" Value="{StaticResource BrCritical}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="ok">
                            <Setter TargetName="body" Property="Fill" Value="{StaticResource BrLow}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="blinkSb">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!-- the circle itself blinks -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="body"
                                                                       Storyboard.TargetProperty="Opacity"
                                                                       Duration="0:0:1.6">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.35"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <!-- ripple ring -->
                                        <DoubleAnimation Storyboard.TargetName="haloScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.9" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="haloScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.9" Duration="0:0:1.6"/>
                                        <DoubleAnimation Storyboard.TargetName="halo"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.55" To="0" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="blinkSb"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
