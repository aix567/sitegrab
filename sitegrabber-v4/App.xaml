<Application x:Class="SiteGrabberV3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SiteGrabberV3.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters available application-wide -->
            <conv:SeverityToColorConverter  x:Key="SevToColor"/>
            <conv:MethodToColorConverter    x:Key="MethodToColor"/>
            <conv:StatusToColorConverter    x:Key="StatusToColor"/>
            <conv:HttpStatusToColorConverter x:Key="HttpStatusToColor"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
